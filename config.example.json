{
  "rules": { "language": "中文", "report_lines": 15, "wake_lines": 5, "max_asks": 3, "away_hours": 2, "cold_read": true, "owner_model": "", "stall_minutes": 15, "inbox_quiet_seconds": 60, "inbox_max_seconds": 300, "inbox_digest_minutes": 30, "recent_done_days": 7 },
  "line_pattern": "^\\s*([A-Z][A-Z0-9]+-\\d+)\\b",
  "slack": {
    "domain": "your-workspace",
    "me": "U0123456789",
    "user_token": { "file": "~/.config/slack/credentials.json", "json_key": "token" },
    "app_token": { "file": "~/.config/slack/app-token" },
    "channels": {
      "C0123456789": { "name": "#some-project", "line": "PROJ-123" },
      "C0987654321": { "name": "#team" }
    }
  },
  "feishu": {
    "accounts": [
      {
        "profile": "示例公司",
        "bot": true,
        "poll": true
      }
    ]
  },
  "projects": { "/absolute/path/to/repo": { "feishu": "示例公司" } },
  "triage": { "about": "Your Name (as shown in chat), and what your team works on", "model": "pi/smol" },
  "ado": { "org": "your-ado-org" },
  "reminders": { "file": "~/.config/reminders.json", "line": "日常" }
}
